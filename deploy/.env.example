# Copy outside the checkout. These values are examples, not provisioned services.
API_IMAGE=neurochess-api:RELEASE_COMMIT
WEB_IMAGE=neurochess-web:RELEASE_COMMIT
WEB_ORIGIN=https://arena.example.com
BETTER_AUTH_URL=https://api.example.com
API_ENV_FILE=/etc/neurochess/api.env
SECRETS_DIR=/etc/neurochess/secrets
# Keep the fixed proxy IP outside the dynamic range; change these three together.
EDGE_SUBNET=172.30.0.0/24
EDGE_DYNAMIC_RANGE=172.30.0.128/25
PROXY_IP=172.30.0.2
