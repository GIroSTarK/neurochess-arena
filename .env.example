NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3001
# Generate a random secret with at least 32 characters before starting the API.
BETTER_AUTH_SECRET=
# Optional complete pair enabling explicit provider-key saving. Keep a stable random
# 32-byte base64 key in deployment secret storage, separate from Better Auth.
# CREDENTIAL_ENCRYPTION_KEY_ID=provider-keys-v1
# CREDENTIAL_ENCRYPTION_KEY=
# Supply each complete pair to enable that OAuth provider. Never use VITE_ variables.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Email flows stay unavailable until SMTP is configured. Production requires smtp.
AUTH_EMAIL_TRANSPORT=disabled
AUTH_EMAIL_FROM=accounts@example.com
# Local development mailbox only. Production must use tls or starttls.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
# Set both when the SMTP server requires authentication; keep secrets outside Git.
# SMTP_USER=
# SMTP_PASSWORD=
VITE_API_BASE_URL=http://localhost:3001
LOG_LEVEL=info
SANDBOX_ENABLED=false
GUEST_SESSION_TTL_SECONDS=86400

# Development-only PostgreSQL placeholders. Do not reuse in production.
# Production requires sslmode=verify-full and the selected host's trusted CA.
# Use deploy/.env.example and docs/operations.md for production configuration.
POSTGRES_DB=neurochess
POSTGRES_USER=neurochess
POSTGRES_PASSWORD=neurochess_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://neurochess:neurochess_dev@127.0.0.1:5432/neurochess

# Disposable integration-test service; never point this at the development database.
TEST_POSTGRES_PORT=5433
TEST_DATABASE_URL=postgresql://neurochess:neurochess_test@127.0.0.1:5433/neurochess_test
