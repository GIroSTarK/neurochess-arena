NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3001
# Generate a private random secret (at least 32 characters); never expose it with VITE_.
BETTER_AUTH_SECRET=
# Email lifecycle endpoints stay closed without SMTP in development/test.
# Production requires smtp; there is no runtime test/log-only sender.
AUTH_EMAIL_TRANSPORT=disabled
# AUTH_EMAIL_FROM=accounts@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# Set both credentials when the SMTP service requires authentication.
# SMTP_USER=
# SMTP_PASSWORD=
VITE_API_BASE_URL=http://localhost:3001
LOG_LEVEL=info
SANDBOX_ENABLED=false
GUEST_SESSION_TTL_SECONDS=86400

# Development-only PostgreSQL placeholders. Do not reuse in production.
POSTGRES_DB=neurochess
POSTGRES_USER=neurochess
POSTGRES_PASSWORD=neurochess_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://neurochess:neurochess_dev@127.0.0.1:5432/neurochess

# Disposable integration-test service; never point this at the development database.
TEST_POSTGRES_PORT=5433
TEST_DATABASE_URL=postgresql://neurochess:neurochess_test@127.0.0.1:5433/neurochess_test
