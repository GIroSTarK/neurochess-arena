{
  "extends": "@neurochess/config/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "scripts/check-docs.ts",
    "scripts/monitoring/**/*.ts",
    "scripts/recovery/**/*.ts",
    "vitest.recovery.config.ts",
    "apps/**/*.test.ts",
    "apps/**/*.test.tsx",
    "apps/api/test/providers/orphaned-turn.ts",
    "apps/api/test/room-recovery-server.ts",
    "apps/api/auth-schema.config.ts",
    "packages/**/*.test.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "playwright.config.ts",
    "playwright.performance.config.ts",
    "apps/web/vite.config.ts",
    "packages/database/drizzle.config.ts",
    "apps/web/src/i18n/*.d.ts",
    "apps/web/src/test/**/*.ts",
    "apps/web/src/test/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx"
  ]
}
