      "checkConstraints": {
        "model_invocations_sequence_check": {
          "name": "model_invocations_sequence_check",
          "value": "\"model_invocations\".\"attempt_number\" > 0 and \"model_invocations\".\"expected_version\" between 0 and 9007199254740991"
        },
        "model_invocations_outcome_check": {
          "name": "model_invocations_outcome_check",
          "value": "\"model_invocations\".\"outcome\" in ('in_flight', 'accepted', 'model_invalid', 'provider_error', 'interrupted', 'discarded')"
        },
        "model_invocations_error_check": {
          "name": "model_invocations_error_check",
          "value": "\n      ((\"model_invocations\".\"error_code\" is null and \"model_invocations\".\"error_reason\" is null)\n      or (\"model_invocations\".\"error_code\" = 'model_invalid' and \"model_invocations\".\"error_reason\" is not null and \"model_invocations\".\"error_reason\" in ('malformed_output', 'illegal_move', 'refusal', 'truncated_output'))\n      or (\"model_invocations\".\"error_code\" in ('provider_auth', 'provider_quota', 'provider_timeout') and \"model_invocations\".\"error_reason\" is null)\n      or (\"model_invocations\".\"error_code\" = 'provider_unavailable' and \"model_invocations\".\"error_reason\" is not null and \"model_invocations\".\"error_reason\" in ('network', 'upstream', 'invalid_response', 'unsupported_model', 'cancelled'))) is true"
        },
        "model_invocations_result_check": {
          "name": "model_invocations_result_check",
          "value": "\n      (\"model_invocations\".\"outcome\" in ('in_flight', 'interrupted') and \"model_invocations\".\"error_code\" is null and \"model_invocations\".\"duration_ms\" is null and not \"model_invocations\".\"usage_reported\" and \"model_invocations\".\"commentary\" is null)\n      or (\"model_invocations\".\"duration_ms\" is not null and (\n        (\"model_invocations\".\"outcome\" = 'accepted' and \"model_invocations\".\"error_code\" is null)\n        or (\"model_invocations\".\"commentary\" is null and (\n          (\"model_invocations\".\"outcome\" = 'model_invalid' and \"model_invocations\".\"error_code\" is not null and \"model_invocations\".\"error_code\" = 'model_invalid')\n          or (\"model_invocations\".\"outcome\" = 'provider_error' and \"model_invocations\".\"error_code\" is not null and \"model_invocations\".\"error_code\" <> 'model_invalid')\n          or \"model_invocations\".\"outcome\" = 'discarded'))))"
        },
        "model_invocations_usage_check": {
          "name": "model_invocations_usage_check",
          "value": "(\"model_invocations\".\"usage_reported\" or (\"model_invocations\".\"input_tokens\" is null and \"model_invocations\".\"output_tokens\" is null and \"model_invocations\".\"total_tokens\" is null))\n      and (\"model_invocations\".\"duration_ms\" is null or \"model_invocations\".\"duration_ms\" between 0 and 9007199254740991)\n      and (\"model_invocations\".\"input_tokens\" is null or \"model_invocations\".\"input_tokens\" between 0 and 9007199254740991)\n      and (\"model_invocations\".\"output_tokens\" is null or \"model_invocations\".\"output_tokens\" between 0 and 9007199254740991)\n      and (\"model_invocations\".\"total_tokens\" is null or \"model_invocations\".\"total_tokens\" between 0 and 9007199254740991)"
        },
        "model_invocations_commentary_check": {
          "name": "model_invocations_commentary_check",
          "value": "\"model_invocations\".\"commentary\" is null or length(\"model_invocations\".\"commentary\") <= 2000"
        },
        "model_invocations_model_id_check": {
          "name": "model_invocations_model_id_check",
          "value": "length(\"model_invocations\".\"model_id\") between 1 and 256 and \"model_invocations\".\"model_id\" ~ '^[a-zA-Z0-9][a-zA-Z0-9._:/@+-]*$'"
        },
        "model_invocations_parameters_check": {
          "name": "model_invocations_parameters_check",
          "value": "jsonb_typeof(\"model_invocations\".\"effective_parameters\") = 'object'\n      and octet_length(\"model_invocations\".\"effective_parameters\"::text) <= 512\n      and \"model_invocations\".\"effective_parameters\" - array['temperature', 'reasoningEffort', 'maxOutputTokens'] = '{}'::jsonb\n      and (not (\"model_invocations\".\"effective_parameters\" ? 'temperature') or case\n        when jsonb_typeof(\"model_invocations\".\"effective_parameters\"->'temperature') = 'number'\n        then (\"model_invocations\".\"effective_parameters\"->>'temperature')::numeric between 0 and 9007199254740991 else false end)\n      and (not (\"model_invocations\".\"effective_parameters\" ? 'reasoningEffort') or (\n        jsonb_typeof(\"model_invocations\".\"effective_parameters\"->'reasoningEffort') = 'string'\n        and length(\"model_invocations\".\"effective_parameters\"->>'reasoningEffort') between 1 and 64\n        and \"model_invocations\".\"effective_parameters\"->>'reasoningEffort' ~ '^[a-zA-Z0-9][a-zA-Z0-9_-]*$'))\n      and (not (\"model_invocations\".\"effective_parameters\" ? 'maxOutputTokens') or case\n        when jsonb_typeof(\"model_invocations\".\"effective_parameters\"->'maxOutputTokens') = 'number'\n        then (\"model_invocations\".\"effective_parameters\"->>'maxOutputTokens')::numeric between 1 and 9007199254740991\n          and mod((\"model_invocations\".\"effective_parameters\"->>'maxOutputTokens')::numeric, 1) = 0 else false end)"
        }
      },
      "isRLSEnabled": false
    },
