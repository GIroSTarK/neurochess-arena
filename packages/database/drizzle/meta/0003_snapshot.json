          "name": "model_invocations_move_check",
          "value": "\"model_invocations\".\"move\" ~ '^[a-h][1-8][a-h][1-8][qrbn]?$' and length(\"model_invocations\".\"move\") in (4, 5)\n        and left(\"model_invocations\".\"move\", 2) <> substring(\"model_invocations\".\"move\" from 3 for 2)"
        },
