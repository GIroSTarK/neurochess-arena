          "name": "model_invocations_commentary_check",
          "value": "length(\"model_invocations\".\"commentary\") <= 2000"
        },
        "model_invocations_timing_check": {
          "name": "model_invocations_timing_check",
          "value": "(\"model_invocations\".\"status\" = 'pending' and \"model_invocations\".\"finished_at\" is null)\n        or (\"model_invocations\".\"status\" <> 'pending' and \"model_invocations\".\"finished_at\" is not null and \"model_invocations\".\"finished_at\" >= \"model_invocations\".\"started_at\")"
        },
        "model_invocations_telemetry_check": {
          "name": "model_invocations_telemetry_check",
          "value": "(\"model_invocations\".\"status\" in ('pending', 'abandoned') and \"model_invocations\".\"latency_ms\" is null and not \"model_invocations\".\"usage_reported\" and \"model_invocations\".\"provider_request_id\" is null)\n        or (\"model_invocations\".\"status\" in ('succeeded', 'model_invalid', 'provider_error') and \"model_invocations\".\"latency_ms\" is not null\n          and \"model_invocations\".\"latency_ms\" >= 0 and \"model_invocations\".\"latency_ms\" < 'Infinity'::float8)"
        },
